def xml_escape(value: str) -> str:
    return (
        value.replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
        .replace("'", "&apos;")
    )


def render_surface_map(project_name: str, profile: str) -> dict[str, str]:
    return {
        "vibe.toml": render_vibe_toml(project_name, profile),
        "docs/vibe/governance.toml": render_governance_toml(),
        "docs/vibe/macros.toml": render_macros_toml(),
        "docs/requirements.xml": render_requirements_xml(project_name, profile),
        "docs/development-plan.xml": render_development_plan_xml(project_name),
        "docs/verification-plan.xml": render_verification_plan_xml(project_name),
        "docs/knowledge-graph.xml": render_knowledge_graph_xml(project_name),
        "docs/decisions.xml": render_decisions_xml(project_name),
        ".vibestart/state/.gitkeep": "",
    }


def write_surfaces(target: Path, rendered: dict[str, str]) -> None:
    for relative_path, content in rendered.items():
        path = target / relative_path
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")


def first_run_contract(profile: str) -> str:
    optional = [
        "external integrations",
        "richer memory backends",
        "multi-agent runtime surfaces",
        "experimental surfaces: auto, multi, calibrate-apply",
    ]
    if profile == "deep":
        optional.insert(2, "deeper deployment and integration scaffolding")

    installed_lines = "\n".join(f"- {surface}" for surface in SHARED_SURFACES)
    optional_lines = "\n".join(f"- {item}" for item in optional)

    return f"""vibestart profile: {profile}

Installed:
{installed_lines}

Active defaults:
- implicit_vibe = true
- autonomy = guided
- agents = single

Optional:
{optional_lines}

Interaction model:
- plain engineering requests enter VIBE implicitly
- guided mode explains recommended paths
- type v or м to accept the current recommendation bundle

Next step:
- replace the placeholder intent in docs/knowledge-graph.xml, define the first real project slice, and drive it through discover -> refine -> deliver/fix -> sync
"""


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    profile = resolve_profile(args)

    target = Path(args.target).resolve()
    project_name = target.name or "project"
    ensure_safe_target(target, force=args.force)

    rendered = render_surface_map(project_name=project_name, profile=profile)

    print(f"Selected profile: {profile}")
    print(f"Target: {target}")
    print("Shared install surface:")
    for surface in SHARED_SURFACES:
        print(f"- {surface}")

    if args.dry_run:
        print("\nDry run only. No files were written.\n")
    else:
        write_surfaces(target, rendered)
        print("\nInstalled shared VIBE surface.\n")

    print(first_run_contract(profile))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
