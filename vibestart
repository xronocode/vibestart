#!/usr/bin/env python3
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent
SHARED_SURFACES = [
    "docs/requirements.xml",
    "docs/development-plan.xml",
    "docs/verification-plan.xml",
    "docs/knowledge-graph.xml",
    "docs/decisions.xml",
    "vibe.toml",
    "docs/vibe/governance.toml",
    "docs/vibe/macros.toml",
    ".vibestart/state/.gitkeep",
]


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="vibestart",
        description="Bootstrap a clean VIBE workspace with explicit core or deep profile selection.",
    )
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--core", action="store_true", help="Bootstrap the core product profile.")
    group.add_argument("--deep", action="store_true", help="Bootstrap the deep product profile.")
    parser.add_argument(
        "--target",
        default=".",
        help="Target directory to bootstrap. Defaults to the current working directory.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show what would be installed without writing files.",
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="Overwrite existing VIBE surfaces in the target.",
    )
    return parser


def resolve_profile(args: argparse.Namespace) -> str:
    if args.core:
        return "core"
    if args.deep:
        return "deep"
    if not sys.stdin.isatty():
        raise SystemExit("Explicit profile selection is required. Use --core or --deep.")

    while True:
        choice = input("Select vibestart profile [core/deep]: ").strip().lower()
        if choice in {"core", "deep"}:
            return choice
        print("Please enter core or deep.", file=sys.stderr)


def target_paths(target: Path) -> list[Path]:
    return [target / relative for relative in SHARED_SURFACES]


def ensure_safe_target(target: Path, force: bool) -> None:
    conflicts = [path for path in target_paths(target) if path.exists()]
    if conflicts and not force:
        conflict_list = "\n".join(f"- {path}" for path in conflicts)
        raise SystemExit(
            "Refusing to overwrite existing VIBE surfaces without --force:\n"
            f"{conflict_list}"
        )


def read_canonical(relative_path: str) -> str:
    return (ROOT / relative_path).read_text(encoding="utf-8")


def render_vibe_toml(project_name: str, profile: str) -> str:
    text = read_canonical("vibe.toml")
    text = text.replace("for this repository", "for this project", 1)
    text = re.sub(r'^name = ".*"$', f'name = "{project_name}"', text, count=1, flags=re.M)
    text = re.sub(
        r'^annotation = ".*"$',
        'annotation = "Active project workspace bootstrapped with VIBE through the optional vibestart product."',
        text,
        count=1,
        flags=re.M,
    )
    text = re.sub(
        r'^profile = "(core|deep)"$',
        f'profile = "{profile}"',
        text,
        count=1,
        flags=re.M,
    )
    return text


def render_governance_toml() -> str:
    text = read_canonical("docs/vibe/governance.toml")
    return text.replace("for this repository", "for this project", 1)


def render_macros_toml() -> str:
    text = read_canonical("docs/vibe/macros.toml")
    return text.replace("for this repository", "for this project", 1)


