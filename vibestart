  <ProjectInfo>
    <name>{xml_escape(project_name)}</name>
    <version>0.1.0-draft</version>
    <annotation>Project workspace bootstrapped by vibestart ({profile}) on top of VIBE.</annotation>
  </ProjectInfo>

  <Identity>
    <definition>This project adopts VIBE (Verified Intent-Based Engineering) as its engineering methodology.</definition>
    <purpose>Use explicit artifacts, macros, verification, and governance to reduce drift between intent, execution, and runtime control behavior.</purpose>
    <surface-model>Canonical project knowledge lives in docs/*.xml, operating contracts live in vibe.toml and docs/vibe/*.toml, and runtime exhaust lives in .vibestart/state/.</surface-model>
    <beta-posture>Bootstrapped through vibestart ({profile}) with a core-first beta operating baseline.</beta-posture>
  </Identity>

  <UseCases>
    <UC-001>
      <title>Capture the first stable project intent</title>
      <actor>Project operator</actor>
      <precondition>The repository has been bootstrapped but project-specific intent has not yet been written down.</precondition>
      <flow>
        <step-1>Record the first stable intent in docs/knowledge-graph.xml.</step-1>
        <step-2>Project clarified intent into requirements, plan, and verification surfaces.</step-2>
      </flow>
      <postcondition>The project has a usable canonical starting point instead of relying on chat memory alone.</postcondition>
      <priority>P0</priority>
      <status>planned</status>
    </UC-001>
    <UC-002>
      <title>Define the first implementation slice</title>
      <actor>Project operator</actor>
      <precondition>The initial intent has been clarified enough to project into a first real project module.</precondition>
      <flow>
        <step-1>Define the first project slice in the knowledge graph.</step-1>
        <step-2>Project that slice into the development and verification surfaces through refine.</step-2>
      </flow>
      <postcondition>The project has one explicit work slice that can move toward implementation and verification.</postcondition>
      <priority>P0</priority>
      <status>planned</status>
    </UC-002>
    <UC-003>
      <title>Close the first slice with verification and sync</title>
      <actor>Project operator</actor>
      <precondition>The first slice is ready for implementation or repair.</precondition>
      <flow>
        <step-1>Implement through deliver or repair through fix.</step-1>
        <step-2>Run the required verification and review path.</step-2>
        <step-3>Run sync when drift needs reconcile or owned runtime exhaust needs cleanup.</step-3>
      </flow>
      <postcondition>The first slice reaches verified continuity instead of code-only completion.</postcondition>
      <priority>P1</priority>
      <status>planned</status>
    </UC-003>
  </UseCases>

  <Constraints>
    <technical>
      <constraint-1>Keep the knowledge graph as the primary semantic spine.</constraint-1>
      <constraint-2>Keep operating contracts readable and reviewable in version control.</constraint-2>
      <constraint-3>Do not treat runtime state as canonical project truth.</constraint-3>
    </technical>
    <business>
      <constraint-1>guided and single remain the normative starting defaults.</constraint-1>
      <constraint-2>Use core as the default beta operating profile unless the project deliberately needs deeper product depth.</constraint-2>
    </business>
  </Constraints>

  <OperatingLoop>
    <step-1>Start from intent and record it in the graph.</step-1>
    <step-2>Use discover and refine before treating the first slice as implementation-ready.</step-2>
    <step-3>Close implementation through deliver or fix, then verify and sync explicitly.</step-3>
  </OperatingLoop>

  <Glossary>
    <term name="VIBE">Verified Intent-Based Engineering.</term>
    <term name="Core">The lighter vibestart bootstrap profile.</term>
    <term name="Deep">The richer vibestart bootstrap profile.</term>
  </Glossary>
  
</Requirements>
"""


