# Kilo Code Environment Profile
# Used by: lib/config/kilo.sh

ENV_NAME="Kilo Code"
ENV_ID="kilo"
CONTEXT_FILE=".kilo/context.md"
MCP_PATH=".kilo/mcp_settings.json"
SKILLS_DIR=".kilo/skills"

# Default settings
CONPORT_DEFAULT="lite"
ENTIRE_DEFAULT="skip"
SHORTCUTS_DEFAULT="enabled"

# MCP server configuration
MCP_CONPORT_COMMAND="uvx"
MCP_CONPORT_ARGS="context-portal-mcp"
MCP_ENTIRE_COMMAND="entire-mcp"
MCP_ENTIRE_ARGS=""
