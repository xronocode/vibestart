# GitHub Copilot Environment Profile
# Used by: lib/config/copilot.sh

ENV_NAME="GitHub Copilot"
ENV_ID="copilot"
CONTEXT_FILE=".github/copilot/instructions.md"
MCP_PATH=".github/copilot/mcp-config.json"
SKILLS_DIR=".github/copilot/skills"

# Default settings
CONPORT_DEFAULT="skip"  # Copilot doesn't support MCP yet
ENTIRE_DEFAULT="skip"
SHORTCUTS_DEFAULT="enabled"

# MCP server configuration (for future use)
MCP_CONPORT_COMMAND="uvx"
MCP_CONPORT_ARGS="context-portal-mcp"
MCP_ENTIRE_COMMAND="entire-mcp"
MCP_ENTIRE_ARGS=""
