# Claude Code Environment Profile
# Used by: lib/config/claude.sh

ENV_NAME="Claude Code"
ENV_ID="claude"
CONTEXT_FILE=".claude/context.md"
MCP_PATH=".claude/mcp-servers.json"
SKILLS_DIR=".claude/skills"

# Default settings
CONPORT_DEFAULT="lite"
ENTIRE_DEFAULT="skip"
SHORTCUTS_DEFAULT="enabled"

# MCP server configuration
MCP_CONPORT_COMMAND="uvx"
MCP_CONPORT_ARGS="context-portal-mcp"
MCP_ENTIRE_COMMAND="entire-mcp"
MCP_ENTIRE_ARGS=""
