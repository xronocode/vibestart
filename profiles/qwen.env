# Qwen Environment Profile
# Used by: lib/config/qwen.sh

ENV_NAME="Qwen"
ENV_ID="qwen"
CONTEXT_FILE=".qwen/context.md"
MCP_PATH=".qwen/mcp-servers.json"
SKILLS_DIR=".qwen/skills"

# Default settings
CONPORT_DEFAULT="lite"
ENTIRE_DEFAULT="skip"
SHORTCUTS_DEFAULT="enabled"

# MCP server configuration
MCP_CONPORT_COMMAND="uvx"
MCP_CONPORT_ARGS="context-portal-mcp"
MCP_ENTIRE_COMMAND="entire-mcp"
MCP_ENTIRE_ARGS=""
